# Public canonical origin used by the client-side metadata updater.
VITE_SITE_URL=https://purehealthpeptidesshop.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_AUTH_ENABLED=false

# Public browser endpoints. Never place secrets in VITE_* variables.
VITE_ACCOUNT_DELETION_ENDPOINT=/api/account/delete-request
VITE_CHECKOUT_ENDPOINT=/api/checkout
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
VITE_ORDER_TRACKING_ENDPOINT=/api/orders/track

# Set to true only when release debugging requires browser source maps.
VITE_BUILD_SOURCEMAP=false

# Server-only local/test values. Configure these in the deployment secret store,
# never as VITE_* variables and never commit real values.
APP_ENV=development
SITE_URL=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_TURNSTILE_SECRET=
CRON_SECRET=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MONITORING_WEBHOOK_URL=
WOOCOMMERCE_URL=https://purehealthpeptides.com
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
COMMERCE_RESERVATIONS_ENABLED=false
WOO_BRIDGE_SECRET_CURRENT=replace_with_at_least_32_random_characters
WOO_BRIDGE_SECRET_PREVIOUS=
WOO_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
